{
  "name": "aiditi",
  "compatibility_date": "2026-10-05",
  "build": {
    "command": "node build.mjs"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Pages and images are free static files; the Worker only sees addresses that are not real files.
    "run_worker_first": false
  },
  "workers_dev": true,
  "main": "worker.js"
}